[Unit]
Description=Read-only local AI agent counts for Click Analytics

[Service]
Type=dbus
BusName=io.github.dginovker.KDEAgentCounts
ExecStart=/usr/bin/python3 %h/.local/lib/kdeclick/agent_count_service.py
Restart=on-failure
RestartSec=5
# A mount/user namespace prevents same-user reads of agent /proc metadata.
NoNewPrivileges=true
# The Pi counter reads lifecycle state over the dashboard's IPv4 loopback HTTP API.
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
